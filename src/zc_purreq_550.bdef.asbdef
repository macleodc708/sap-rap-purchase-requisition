projection;
strict ( 2 );
use draft;
use side effects;

define behavior for ZC_PurReq_550 alias PurReq
use etag
{
  use create;
  use update;
  use delete;

  use action submit;
  use action withdraw;
  use action approve;
  use action reject;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _Item { create; with draft; }
}

define behavior for ZC_PurReqItem_550 alias Item
use etag
{
  use update;
  use delete;

  use association _PurReq { with draft; }
}
